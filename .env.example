# ---- Global ----
# 1 = everything mocked, fully offline. Individual USE_* flags only matter when MOCK_MODE=0.
MOCK_MODE=1

# ---- LLM (Emma's planner + fallback for bank agents) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Sponsors: USE_*=1 turns on the REAL adapter (falls back to mock on any error) ----
USE_AIRBYTE=0
AIRBYTE_API_KEY=
AIRBYTE_WORKSPACE_ID=

USE_COGNEE=0
# Cognee Cloud tenant URL (https://<tenant>.aws.cognee.ai) or self-hosted http://localhost:8000
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
LLM_API_KEY=

USE_SIE=0
SIE_API_KEY=
SIE_BASE_URL=

USE_PERSONA=0
# Sandbox API key (persona_sandbox_...) and an inquiry template id (itmpl_...)
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
# Optional: pin an API version (e.g. 2026-09-29); empty = account default. PERSONA_ENV=sandbox enables simulate actions
PERSONA_VERSION=
PERSONA_ENV=sandbox

USE_GUILD=0
# Account API key as "<key id>:<secret>"; workspace id or name for mirrored policy/trace contexts
GUILD_API_KEY=
GUILD_WORKSPACE=
GUILD_API_URL=https://api.guild.ai/v1

USE_SINGLESTORE=0
# e.g. user:password@svc-xxxx.svc.singlestore.com:3306/envoy  (mysql:// prefix also accepted)
SINGLESTORE_URL=

USE_ARCEE=0
# OpenAI-compatible; defaults: https://api.arcee.ai/api/v1 and trinity-mini
ARCEE_BASE_URL=
ARCEE_API_KEY=
ARCEE_MODEL=

USE_FIREDRILL=0
FIREDRILL_API_KEY=

USE_STATSIG=0
STATSIG_SERVER_KEY=

USE_AMPLITUDE=0
AMPLITUDE_API_KEY=

# ---- Service URLs ----
ENVOY_URL=http://localhost:8000
CLIENT_AGENT_URL=http://localhost:8200
BANK_A_URL=http://localhost:8101
BANK_B_URL=http://localhost:8102
BANK_C_URL=http://localhost:8103
NEXT_PUBLIC_ENVOY_URL=http://localhost:8000

# ---- Live mode: Gmail as a CONTEXT source (docs/email_context_spec.md). Email never drives an action. ----
# LIVE_MODE=1 + GMAIL_APP_PASSWORD -> client agent watches the inbox read-only over IMAP.
LIVE_MODE=0
GMAIL_USER=emma.envoy.demo@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_POLL_SECONDS=5
# Optional: PyAirbyte source-gmail config JSON, used instead of IMAP when USE_AIRBYTE=1
AIRBYTE_GMAIL_CONFIG=
# scripts/seed_inbox.py (make seed-inbox): a team demo account (e.g. escrow.team.demo@gmail.com), never the attacker
SEED_SENDER_USER=
SEED_SENDER_APP_PASSWORD=

# Sponsors credited in badges (others are future scope, see docs/future_scope.md)
ACTIVE_SPONSORS=cognee,persona,guild
NEXT_PUBLIC_ACTIVE_SPONSORS=cognee,persona,guild
